generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// =========================================================
// CORE PACKAGE CATALOG
// =========================================================

model Package {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  location    String
  category    String
  tourType    String
  days        Int
  nights      Int
  cities      Int
  price       Int
  emi         Int
  rating      Float   @default(5)
  reviews     Int     @default(0)
  description String
  imageUrl    String?

  country       String?
  state         String?
  relatedGroup  String?

  departureCities   Json?
  highlights        Json
  inclusions        Json
  exclusions        Json?
  itinerary         Json
  departures        Json
  needToKnow        Json?
  cancellationPolicy Json?
  paymentTerms      Json?
  upgrades          Json?
  tourDetails       Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// CURATED DESTINATION ZONE / LANDING PAGES (India + World)
// =========================================================

model Destination {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  parent      String // "india" | "world"
  name        String
  heading     String
  metaTitle   String
  metaDescription String

  breadcrumbTrail Json
  packageCount    Int    @default(0)
  liveTourCount   Int    @default(0)
  reviewsLabel    String

  intro      String
  introExtra String

  tabs                 Json
  countries            Json?
  cities               Json?
  packageSlugs         Json
  joiningLeavingCities Json?
  related              Json?
  regions              Json?

  faqHeading    String?
  faqSubheading String?
  faqs          Json?

  seoParagraphs      Json?
  seoExtraParagraphs Json?

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// DEPARTURE CITY PAGES ("Tour Packages From {City}")
// =========================================================

model DepartureCity {
  id             Int    @id @default(autoincrement())
  slug           String @unique
  name           String
  departures     Int
  startingPrice  Int
  packageCount   Int
  reviewsLabel   String
  intro          String
  introExtra     String
  packageSlugs      Json
  linkCloudTargets  Json

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// FLIGHTS
// =========================================================

model FlightRoute {
  id            Int     @id @default(autoincrement())
  slug          String  @unique
  from          String
  fromCode      String
  to            String
  toCode        String
  international Boolean @default(false)
  baseDuration  Int
  minPrice      Int
  maxPrice      Int
  count         Int
  allowStops    Boolean @default(true)
  description   String
  relatedTours  Json
  otherRoutes   Json

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Airport {
  id      Int    @id @default(autoincrement())
  city    String
  code    String @unique
  country String

  order Int @default(0)
}

model Airline {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  code    String
  logoUrl String?
  color   String  @default("#0F4C81")

  order Int @default(0)
}

model TransportOption {
  id           Int     @id @default(autoincrement())
  type         String  // "Car" | "Bus"
  name         String
  image        String?
  capacity     Int
  acType       String  @default("AC")
  pricePerKm   Int
  basePrice    Int
  description  String
  features     Json

  order Int @default(0)
}

model TransportRoute {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  from        String
  to          String
  distanceKm  Int
  duration    String
  description String

  order Int @default(0)
}

model Hotel {
  id                Int     @id @default(autoincrement())
  slug              String  @unique
  name              String
  city              String
  citySlug          String
  starRating        Int     @default(4)
  rating            Float   @default(4.5)
  reviewCount       Int     @default(120)
  address           String
  description       String
  image             String?
  pricePerNight     Int
  amenities         Json
  rooms             Json
  checkInTime       String  @default("2:00 PM")
  checkOutTime      String  @default("11:00 AM")
  nearbyAttractions Json?

  order Int @default(0)
}

// =========================================================
// INDIA LANDING PAGE (/india) — independently curated content
// =========================================================

model IndiaZoneCard {
  id     Int     @id @default(autoincrement())
  region String  // North | South | West & Central | East & North East
  name   String
  tours  String
  visual String  // tailwind gradient classes
  image  String?

  order Int @default(0)
}

model IndiaListingPackage {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  title      String
  image      String
  tags       Json
  days       String
  cities     String
  dates      String
  price      String
  emi        String
  highlights String

  order Int @default(0)
}

model IndiaExploreTile {
  id     Int     @id @default(autoincrement())
  group  String  // "city" | "state" | "March to June" | "July to October" | "November to February"
  name   String
  tours  String
  visual String
  image  String?

  order Int @default(0)
}

model IndiaExploreInterest {
  id             Int     @id @default(autoincrement())
  title          String
  slug           String
  isDestinationLink Boolean @default(false)
  tag            String
  days           String
  cities         String
  price          String
  emi            String

  order Int @default(0)
}

model IndiaExploreDuration {
  id       Int    @id @default(autoincrement())
  title    String
  slug     String
  category String
  days     Int
  cities   Int
  price    String

  order Int @default(0)
}

model IndiaBlog {
  id    Int    @id @default(autoincrement())
  title String
  style String // tailwind gradient classes

  order Int @default(0)
}

model IndiaReview {
  id       Int    @id @default(autoincrement())
  name     String
  tour     String
  category String
  review   String
  manager  String

  order Int @default(0)
}

model IndiaFaq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String

  order Int @default(0)
}

// =========================================================
// HOME PAGE SECTIONS (mirrors src/data/homeData.js keys)
// =========================================================

model HeroCard {
  id       Int    @id @default(autoincrement())
  title    String
  subtitle String

  order Int @default(0)
}

model HomeDestination {
  id        Int    @id @default(autoincrement())
  name      String
  tourCount String
  icon      String // lucide-react icon name

  order Int @default(0)
}

model LiveTourCard {
  id             Int     @id @default(autoincrement())
  destination    String
  liveTourCount  String
  color1         String
  color2         String
  color3         String
  image          String?

  order Int @default(0)
}

model ChinaPromoPackage {
  id    Int    @id @default(autoincrement())
  days  String
  name  String
  price String
  slug  String

  order Int @default(0)
}

model MostLovedPromoDestination {
  id    Int    @id @default(autoincrement())
  name  String
  days  String
  price String

  order Int @default(0)
}

model MostLovedDestination {
  id     Int     @id @default(autoincrement())
  name   String
  price  String
  guests String
  slug   String
  image  String?

  order Int @default(0)
}

model TrustStat {
  id    Int    @id @default(autoincrement())
  value String
  label String
  icon  String

  order Int @default(0)
}

model TrustReview {
  id          Int    @id @default(autoincrement())
  type        String
  destination String
  excerpt     String
  guest       String
  date        String

  order Int @default(0)
}

model FeaturedTourSlide {
  id         Int     @id @default(autoincrement())
  region     String
  title      String
  locations  String
  days       String
  date       String
  departure  String
  price      String
  image      String?

  order Int @default(0)
}

model ContinueTravelTour {
  id       Int    @id @default(autoincrement())
  name     String
  duration String
  price    String
  cta      String
  slug     String

  order Int @default(0)
}

model TourInclusionFeature {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  icon        String

  order Int @default(0)
}

model FaqItem {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String?

  order Int @default(0)
}

model PromoSlide {
  id          Int     @id @default(autoincrement())
  type        String  // "welcome" | "poster"
  title       String?
  subtitle    String?
  ctaLabel    String?
  price       String?
  gradientFrom String?
  gradientVia  String?
  gradientTo   String?

  order Int @default(0)
}

// =========================================================
// BOOKINGS
// =========================================================

model Booking {
  id             Int      @id @default(autoincrement())
  packageSlug    String
  packageTitle   String
  departureCity  String
  departureDate  String
  guests         Int      @default(1)
  totalPrice     Int
  customerName   String
  customerPhone  String
  customerEmail  String?
  status         String   @default("New")
  createdAt      DateTime @default(now())

  order Int @default(0)
}

// =========================================================
// ADMIN
// =========================================================

model AdminSetting {
  key   String @id
  value String
}
