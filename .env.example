# =========================================================
# Honor Tour & Travels — environment template
# Copy to .env.local (or .env) and fill in. NEVER commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle.
# Secrets must NOT use that prefix.
# =========================================================

# ---------- Database ----------
# Standard (non-SRV) Atlas URI is used because some networks refuse SRV lookups.
MONGODB_URI="mongodb://user:password@host1:27017,host2:27017/travel2?ssl=true&replicaSet=REPLICA_SET&authSource=admin&retryWrites=true&w=majority"
# Optional: only when the database name is not in the URI path.
MONGODB_DB=""

# ---------- Site ----------
NEXT_PUBLIC_APP_URL="https://travel-world-sepia.vercel.app"
NEXT_PUBLIC_SITE_URL="https://travel-world-sepia.vercel.app"

# ---------- Admin panel ----------
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ---------- Booking alert emails (SMTP) ----------
# Gmail works with an App Password (not the account password).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Blank = alerts go to SMTP_USER.
BOOKING_ALERT_TO=""

# =========================================================
# TRAVEL SUPPLIER  (server-only — never NEXT_PUBLIC_)
# =========================================================
# Which adapter in src/lib/travel/providers/ to use.
# Blank = no live inventory: every travel API answers 503 and the site
# tells customers to call. It never falls back to sample data.
TRAVEL_PROVIDER=""

TRAVEL_API_BASE_URL=""
TRAVEL_API_KEY=""
TRAVEL_API_SECRET=""

# Optional: some suppliers issue separate credentials per product.
TRAVEL_FLIGHTS_API_KEY=""
TRAVEL_HOTELS_API_KEY=""
TRAVEL_BUSES_API_KEY=""

# Supplier request timeout in milliseconds (default 20000).
TRAVEL_API_TIMEOUT_MS="20000"

# =========================================================
# PAYMENT GATEWAY  (server-only except the public key)
# =========================================================
# Blank = online payment is off; /api/payment/create-order answers 503.
PAYMENT_PROVIDER=""

# Razorpay. KEY_ID is publishable and is returned by create-order for checkout.
# KEY_SECRET signs and verifies payments and must never reach the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
